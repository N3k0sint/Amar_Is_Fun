{
  "name": "sprm-quest",
  "version": "1.0.0",
  "description": "SPRM Quest: The Officer's Journey",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "serve-game": "http-server www -p 3000 -c-1",
    "dist": "electron-builder",
    "mobile:init": "npx cap init",
    "mobile:add-android": "npx cap add android",
    "mobile:sync": "npx cap sync",
    "mobile:open": "npx cap open android"
  },
  "author": "SPRM",
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "^5.0.0",
    "@capacitor/core": "^5.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^5.0.0",
    "electron": "^25.0.0",
    "electron-builder": "^24.4.0",
    "http-server": "^14.1.1"
  },
  "build": {
    "appId": "com.sprmquest.game",
    "productName": "SPRM Quest",
    "win": {
      "target": "portable"
    }
  }
}
